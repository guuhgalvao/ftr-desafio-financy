    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-day-picker": "9.14.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-router": "7.18.4",
    "rxjs": "7.8.2",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
